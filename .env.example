# ===== Prism 棱镜 · 环境变量配置 =====
# 复制本文件为 .env，填入真实值后执行 docker compose up -d

# 会话签名密钥 —— 生产请改成随机长字符串（可用 openssl rand -hex 32 生成）
SESSION_SECRET=change-me-in-production

# ===== 管理员后台 =====
# 访问 /admin 输入此密码登录，用于确认用户扫码支付订单
ADMIN_PASSWORD=admin

# ===== 上游模型（OpenAI 兼容）=====
# 不配置则使用内置演示引擎；配置后所有请求统一转发到上游
UPSTREAM_BASE_URL=https://ai.kaiweb.net/v1
UPSTREAM_API_KEY=sk-你的密钥
# 转发时统一替换成的上游模型名（留空则透传前端选择的模型名）
UPSTREAM_MODEL=glm-5.2
# 关闭上游思维链（reasoning_content），流式直接输出 content
# glm 系列建议保持 true；其他模型可设为 false
UPSTREAM_DISABLE_THINKING=true

# ===== 可选配置 =====
# 对外访问地址（生产必填，用于生成支付回调地址）
# PUBLIC_ORIGIN=https://your-domain.com

# ===== 易支付（不配置则使用内置模拟收银台）=====
# EPAY_URL=https://你的易支付网关地址
# EPAY_PID=你的商户ID
# EPAY_KEY=你的商户密钥

# ===== USAD 加密货币充值（不配置则前端隐藏该支付方式）=====
# USAD_GATEWAY=https://你的网关地址
# USAD_ACCESS_KEY=你的AccessKey
# USAD_API_SECRET=你的ApiSecret
# 1 USAD 折算人民币入账汇率（默认 1）
USAD_RATE=1
