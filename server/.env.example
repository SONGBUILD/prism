# ===== 基础 =====
PORT=8787
# 对外访问地址（生产必填，用于生成支付回调地址）
# PUBLIC_ORIGIN=https://your-domain.com
# 会话签名密钥（生产请改成随机长字符串）
SESSION_SECRET=change-me-in-production

# ===== 易支付（不配置则使用内置模拟收银台，回调链路完全一致）=====
# EPAY_URL=https://你的易支付网关地址
# EPAY_PID=你的商户ID
# EPAY_KEY=你的商户密钥

# ===== 上游模型（不配置则使用内置演示引擎）=====
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=sk-xxx
# 可选：把所有请求统一转发到上游的某一个模型
# UPSTREAM_MODEL=gpt-4o-mini

# ===== USAD 加密货币充值（不配置则前端隐藏该支付方式）=====
# USAD_GATEWAY=https://你的网关地址
# USAD_ACCESS_KEY=你的AccessKey
# USAD_API_SECRET=你的ApiSecret
# 1 USAD 折算人民币入账汇率（默认 1）
USAD_RATE=1
